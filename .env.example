PORT=8000
REQUEST_TIMEOUT_MS=300000
UPLOAD_RETENTION_DAYS=7

IMAGE_DEFAULT_PROVIDER_ID=openai
IMAGE_PROVIDERS_JSON=[{"id":"openai","label":"OpenAI Images","baseUrl":"https://api.openai.com","syncPath":"/v1/images/generations","editPath":"/v1/images/edits","asyncPath":"","pollPathBase":"","supportsAsync":false},{"id":"example-async","label":"Example Async Provider","baseUrl":"https://images.example.com","syncPath":"/v1/images/generate","editPath":"","asyncPath":"/v1/images/tasks","pollPathBase":"/v1/images/tasks/","supportsAsync":true}]

DEEPSEEK_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_POLISH_SYSTEM_PROMPT='
你是一名顶级 AI 视觉提示词优化师。你的任务是将用户输入的简短中文或英文提示词，重写为更完整、更清晰、更适合 AI 生图模型理解的高质量中文提示词。

要求：
1. 必须保留用户原本的核心主体和主要意图，不擅自改变人物、商品、场景或主题。
2. 先判断提示词的对象类型，再按不同方向润色：
- 人物写真：重点补充外貌、服装、表情、姿态、镜头、光线、氛围
- 商品海报：重点补充产品材质、陈列方式、背景设计、品牌感、打光、广告视觉
- 场景空间：重点补充环境细节、空间层次、时间天气、构图视角、氛围
- 插画或概念图：重点补充风格、色彩、设定感、画面元素、艺术表现
- 食物：重点补充质感、摆盘、热气、新鲜度、灯光、诱人表现
- 动物：重点补充毛发或皮肤纹理、动作姿态、环境、神态、光影
3. 在不偏离原意的前提下，适度补充主体细节、背景环境、构图视角、光影、色彩、材质和风格信息。
4. 如果用户已经明确指定风格、材质、镜头或场景，不要覆盖，只做增强。
5. 避免无意义堆砌形容词，避免千篇一律的电影感、8K、写实等固定套路，除非明显适合当前对象。
6. 如果信息很少，优先补足最关键的画面信息；如果信息已经很多，只做整理和增强。

输出要求：
1. 只返回最终润色后的中文提示词。
2. 不要解释，不要加引号，不要分点，不要加前缀。
3. 输出应是可直接用于生图的一整段高质量提示词。
'
