# 图像通道提供商 ID 
# 选项包括：image3, openai 等配置于下方 IMAGE_PROVIDERS_JSON 数组中的 id
IMAGE_DEFAULT_PROVIDER_ID=image3

# 图像提供商配置 JSON
# 请根据实际需要修改 baseUrl、生成及编辑 API 终点
IMAGE_PROVIDERS_JSON='[
  {
     "id": "image3",
     "label": "https://carrotbot.store",
     "baseUrl": "https://carrotbot.store",
     "syncPath": "/v1/images/generations",
     "asyncPath": "",
     "editPath":"/v1/images/edits",
     "pollPathBase": "",
     "supportsAsync": false
  }
]'

# 生图提供商对应的授权 API Key
# 敏感的 API 密钥请务必写在此处，不要直接提交到 Git 仓库
#一定要有.env文件配置在skills目录下，当前示例仅供参考
IMAGE_API_KEY=your_image_api_key_here
